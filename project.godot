; Engine configuration file.
; Strata Animation Studio — targets Godot 4.7.2 (stable).

config_version=5

[application]

config/name="Strata Animation Studio"
config/description="2D animation with real 3D depth: draw, animate, stage layers in 3D and render."
config/version="0.1.0"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/low_processor_mode=true

[autoload]

App="*res://core/app_state.gd"
History="*res://core/history.gd"
Ops="*res://core/edit_ops.gd"
ProjectIO="*res://core/project_io.gd"
Rigs="*res://core/rig_manager.gd"
Audio="*res://core/audio_engine.gd"
Updater="*res://core/updater.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/size/mode=2
window/dpi/allow_hidpi=true
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.0745, 0.0784, 0.0941, 1)
